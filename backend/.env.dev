# Conexao com PostgreSQL + pgvector (via rede interna do Docker — host = nome do servico)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://tutoriatech_user:tutoriatech_pass@db:5432/tutoriatech?schema=public"

# Porta em que o Fastify vai escutar
PORT=3001

# Segredo para assinar JWT (troque em producao!)
JWT_SECRET=mude_esse_segredo_em_producao
